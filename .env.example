# ==========================================
# FinBuddy Environment Configuration
# ==========================================

# LLM Providers (Configure at least one or rely on local fallback mode)
OPENAI_API_KEY=your_openai_api_key_here
# Alternative: Gemini API key
GOOGLE_API_KEY=your_gemini_api_key_here

# LLMOps Tracing (LangSmith)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=FinBuddy-Production

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Model Paths
MODEL_PATH=models/credit_risk_xgb.pkl
METRICS_PATH=models/model_metrics.json
DATA_BASELINE_PATH=data/credit_baseline.csv
